<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ppo_planner</name>
  <version>1.0.0</version>
  <description>ROS2 node wrapping an ONNX-exported PPO policy (numpy + onnxruntime, no torch) for grid navigation planning</description>
  <maintainer email="deleeuwlars@icloud.com">LarsDeLeeuw</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tb3_interfaces</exec_depend>
  <exec_depend>tb3_planner_common</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- onnxruntime has no rosdep key; install it manually with pip (see README). -->


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

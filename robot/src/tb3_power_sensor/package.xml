<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_power_sensor</name>
  <version>1.0.0</version>
  <description>INA219 power-sensing node (solar/SBC/OpenCR rails) + SBC thermal telemetry for the TurtleBot3 power experiment</description>
  <maintainer email="deleeuwlars@icloud.com">LarsDeLeeuw</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tb3_interfaces</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
